{
  "expo": {
    "name": "Bean Trail",
    "slug": "bean-trail",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "scheme": "beantrail",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.beantrail.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Bean Trail uses your location to tag where you're enjoying your coffee.",
        "NSPhotoLibraryUsageDescription": "Bean Trail saves photos of your coffee check-ins.",
        "NSCameraUsageDescription": "Bean Trail lets you snap a photo of your coffee for each check-in."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.beantrail.app",
      "permissions": [
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-image-picker"
    ]
  }
}
